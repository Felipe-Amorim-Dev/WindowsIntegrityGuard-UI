<UserControl x:Class="WindowsIntegrityGuard.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">

        <StackPanel>

            <!-- HEADER -->
            <StackPanel Margin="0,0,0,22">

                <TextBlock Text="Ajustes"
                           Style="{StaticResource PageTitleStyle}"/>

                <TextBlock Text="Configure inicialização, comportamento e notificações."
                           Style="{StaticResource PageDescriptionStyle}"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <!-- STARTUP -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                Background="#17294F"
                                CornerRadius="12">

                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource BlueAccentBrush}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Inicialização"
                                       Style="{StaticResource DashboardTitleStyle}"/>

                            <TextBlock Text="Configure como a aplicação deve iniciar."
                                       Style="{StaticResource DashboardDescriptionStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Iniciar com o Windows"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Abre o Windows Integrity Guard automaticamente ao entrar no Windows."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,30,0"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding StartWithWindows}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    </Grid>

                    <Border Height="1"
                            Background="#263657"
                            Margin="0,0,0,18"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Iniciar minimizado"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Quando iniciado automaticamente, permanece na área de notificação."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,30,0"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding StartMinimized}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- AUTO SCAN -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                Background="#15372F"
                                CornerRadius="12">

                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Verificação automática"
                                       Style="{StaticResource DashboardTitleStyle}"/>

                            <TextBlock Text="Controle a verificação após a inicialização."
                                       Style="{StaticResource DashboardDescriptionStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Verificar integridade após iniciar o Windows"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="O Service aguarda 2 minutos antes de iniciar a verificação."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,30,0"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ScanOnStartup}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- BEHAVIOR -->
            <Border Style="{StaticResource DashboardCardStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                Background="#1D294A"
                                CornerRadius="12">

                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource BlueAccentBrush}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Comportamento"
                                       Style="{StaticResource DashboardTitleStyle}"/>

                            <TextBlock Text="Defina como a interface deve se comportar."
                                       Style="{StaticResource DashboardDescriptionStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Manter na traybar ao fechar"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Ao fechar a janela, mantém o aplicativo ativo na área de notificação."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,30,0"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding MinimizeToTray}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- NOTIFICATIONS -->
            <Border Style="{StaticResource DashboardCardStyle}">

                <StackPanel>

                    <Grid Margin="0,0,0,22">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44"
                                Height="44"
                                Background="#3A3314"
                                CornerRadius="12">

                            <TextBlock Text="&#xEA8F;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource YellowAccentBrush}"
                                       FontSize="19"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Notificações"
                                       Style="{StaticResource DashboardTitleStyle}"/>

                            <TextBlock Text="Controle os avisos exibidos pela aplicação."
                                       Style="{StaticResource DashboardDescriptionStyle}"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Exibir notificações"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Exibe avisos ao concluir verificações ou quando o Service fica indisponível."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,30,0"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ShowNotifications}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>