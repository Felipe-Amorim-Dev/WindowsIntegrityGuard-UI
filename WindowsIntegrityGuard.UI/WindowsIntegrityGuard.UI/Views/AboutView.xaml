<UserControl x:Class="WindowsIntegrityGuard.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <StackPanel>
        <TextBlock Text="Sobre" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Informações sobre o Windows Integrity Guard." Foreground="#8FA6BA" FontSize="13" Margin="0,6,0,24"/>

        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Foreground="#8FA6BA" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Versão" Style="{StaticResource DashboardDescriptionStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Version}" Foreground="White"/>

                <TextBlock Grid.Row="1" Text="Service" Style="{StaticResource DashboardDescriptionStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceName}" Foreground="White"/>

                <TextBlock Grid.Row="2" Text="Status do Service" Style="{StaticResource DashboardDescriptionStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServiceStatus}" Foreground="White"/>

                <TextBlock Grid.Row="3" Text="Licença" Style="{StaticResource DashboardDescriptionStyle}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding License}" Foreground="White"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource DashboardCardStyle}">
            <StackPanel>
                <TextBlock Text="Projeto" Style="{StaticResource DashboardTitleStyle}"/>
                <TextBlock Text="Código-fonte e documentação do Windows Integrity Guard." Style="{StaticResource DashboardDescriptionStyle}" Margin="0,6,0,16"/>

                <Button Content="Abrir repositório no GitHub"
                        Command="{Binding OpenRepositoryCommand}"
                        Width="220"
                        Height="40"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>