<UserControl x:Class="WindowsIntegrityGuard.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <StackPanel>

        <!-- HEADER -->
        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Histórico"
                           Style="{StaticResource PageTitleStyle}"/>

                <TextBlock Text="Consulte as verificações de integridade realizadas anteriormente."
                           Style="{StaticResource PageDescriptionStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- RESUMO -->
        <Border Style="{StaticResource DashboardCardStyle}"
                Margin="0,0,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="54"
                        Height="54"
                        Background="#33415F"
                        CornerRadius="14">

                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="{StaticResource CyanAccentBrush}"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">

                    <TextBlock Text="Histórico de verificações"
                               Style="{StaticResource DashboardTitleStyle}"/>

                    <TextBlock Text="Os resultados mais recentes aparecem primeiro."
                               Style="{StaticResource DashboardDescriptionStyle}"
                               Margin="0,5,0,0"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- LISTA -->
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Style="{StaticResource DashboardCardStyle}"
                            Margin="0,0,0,12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- INDICADOR -->
                            <Border Grid.Column="0"
                                    Background="{Binding Status, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                                    CornerRadius="3"/>

                            <!-- INFORMAÇÕES -->
                            <StackPanel Grid.Column="2">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <Border Background="#34405D"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            Margin="12,0,0,0">

                                        <TextBlock Text="{Binding Date}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12"/>
                                    </Border>

                                </StackPanel>

                                <TextBlock Text="{Binding Message}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="14"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- DETALHES -->
                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <TextBlock Text="Horário"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding Time}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">

                                    <TextBlock Text="Duração"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>

                                    <TextBlock Text="{Binding DurationText}"
                                               Foreground="{StaticResource YellowAccentBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"/>
                                </StackPanel>

                            </StackPanel>

                        </Grid>
                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ESTADO VAZIO -->
        <Border Background="#252F49"
                BorderBrush="#394561"
                BorderThickness="1"
                CornerRadius="16"
                Padding="30"
                Margin="0,6,0,0"
                Visibility="{Binding Items, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="&#xE823;"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="32"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Nenhuma verificação registrada"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0"/>

                <TextBlock Text="As verificações realizadas aparecerão aqui."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13"
                           Margin="0,5,0,0"/>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>