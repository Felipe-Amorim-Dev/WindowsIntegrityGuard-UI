<UserControl x:Class="WindowsIntegrityGuard.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel>

            <TextBlock Text="Histórico"
                       Style="{StaticResource PageTitleStyle}"/>

            <TextBlock Text="Consulte as verificações realizadas anteriormente."
                       Style="{StaticResource PageDescriptionStyle}"
                       Margin="0,7,0,0"/>

        </StackPanel>

        <!-- RESUMO -->
        <Border Grid.Row="2"
                Style="{StaticResource DashboardCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="46"
                        Height="46"
                        Background="#17294F"
                        CornerRadius="12">

                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="{StaticResource BlueAccentBrush}"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Histórico de verificações"
                               Style="{StaticResource DashboardTitleStyle}"/>

                    <TextBlock Text="Os resultados mais recentes aparecem primeiro."
                               Style="{StaticResource DashboardDescriptionStyle}"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- LISTA -->
        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,8,0">

            <ItemsControl ItemsSource="{Binding Items}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Style="{StaticResource DashboardCardStyle}"
                                Margin="0,0,0,12"
                                Padding="18">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{Binding Status, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                                        CornerRadius="3"/>

                                <StackPanel Grid.Column="2">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <Border Background="#1B2948"
                                                CornerRadius="8"
                                                Padding="8,4"
                                                Margin="12,0,0,0">

                                            <TextBlock Text="{Binding Date}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"/>

                                        </Border>

                                    </StackPanel>

                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,9,20,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Time, StringFormat=Horário: {0}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Text="{Binding DurationText, StringFormat=Duração: {0}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Text="{Binding ExitCode, StringFormat=Exit code: {0}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>