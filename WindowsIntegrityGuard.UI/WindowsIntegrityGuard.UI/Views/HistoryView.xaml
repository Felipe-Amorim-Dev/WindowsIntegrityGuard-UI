<UserControl x:Class="WindowsIntegrityGuard.UI.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Histórico" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#8FA6BA" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data" Style="{StaticResource DashboardDescriptionStyle}"/>
                                <TextBlock Text="{Binding Date}" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Resultado" Style="{StaticResource DashboardDescriptionStyle}"/>
                                <TextBlock Text="{Binding Status}" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Duração" Style="{StaticResource DashboardDescriptionStyle}"/>
                                <TextBlock Text="{Binding Duration}" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Mensagem" Style="{StaticResource DashboardDescriptionStyle}"/>
                                <TextBlock Text="{Binding Message}" Foreground="White" Margin="0,5,20,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Revisão" Style="{StaticResource DashboardDescriptionStyle}"/>
                                <TextBlock Text="{Binding RepairReview}" Foreground="White" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
