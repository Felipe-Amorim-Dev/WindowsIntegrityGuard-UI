<UserControl x:Class="WindowsIntegrityGuard.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WindowsIntegrityGuard.UI.Controls"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="230"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="112"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- ====================================================== -->
            <!-- HEADER -->
            <!-- ====================================================== -->

            <Grid Grid.Row="0" Margin="0,0,150,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Windows Integrity Guard"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Painel de integridade"
                               Style="{StaticResource PageTitleStyle}"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Acompanhe o estado do Windows e execute novas verificações."
                               Style="{StaticResource PageDescriptionStyle}"
                               Margin="0,7,0,0"/>

                </StackPanel>

                <!-- STATUS DO SERVICE -->

                <Border Grid.Column="1"
                        Background="{Binding ServiceBadgeBackground}"
                        BorderBrush="{Binding ServiceBadgeBorder}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="13,8"
                        VerticalAlignment="Top"
                        Margin="0,3,0,0">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ServiceBadgeForeground}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="{Binding ServiceStatus}"
                                   Foreground="{Binding ServiceBadgeForeground}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ====================================================== -->
            <!-- HERO + RESUMO -->
            <!-- ====================================================== -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================== -->
                <!-- HERO -->
                <!-- ================================================== -->

                <Border Grid.Column="0"
                        BorderBrush="#6E304A"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="30">

                    <!-- GRADIENTE -->
                    <Border.Background>

                        <LinearGradientBrush StartPoint="0,0.5"
                                             EndPoint="1,0.5">

                            <GradientStop Color="#341724"
                                          Offset="0"/>

                            <GradientStop Color="#2B1830"
                                          Offset="0.20"/>

                            <GradientStop Color="#1F1E3C"
                                          Offset="0.50"/>

                            <GradientStop Color="#162345"
                                          Offset="0.78"/>

                            <GradientStop Color="#12264B"
                                          Offset="1"/>

                        </LinearGradientBrush>

                    </Border.Background>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========================================== -->
                        <!-- INDICADOR -->
                        <!-- ========================================== -->

                        <Grid Width="118"
                              Height="118"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">

                            <!-- ====================================== -->
                            <!-- ALERTA VERMELHO -->
                            <!-- ====================================== -->

                            <Grid x:Name="AlertIndicator">

                                <Grid.Style>

                                    <Style TargetType="Grid">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                        <Style.Triggers>

                                            <!-- DURANTE SCAN ESCONDE ALERTA -->
                                            <DataTrigger Binding="{Binding IsScanning}"
                                                         Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Grid.Style>

                                <!-- HALO -->
                                <Ellipse Width="116"
                                         Height="116"
                                         Fill="#401C2A"
                                         Opacity="0.55"/>

                                <!-- ANEL PULSANTE -->

                                <Ellipse x:Name="PulseRing"
                                         Width="100"
                                         Height="100"
                                         Fill="#351B27"
                                         Stroke="{StaticResource RedAccentBrush}"
                                         StrokeThickness="3"
                                         RenderTransformOrigin="0.5,0.5">

                                    <Ellipse.RenderTransform>

                                        <ScaleTransform x:Name="PulseScale"
                                                        ScaleX="1"
                                                        ScaleY="1"/>

                                    </Ellipse.RenderTransform>

                                    <Ellipse.Triggers>

                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

                                            <BeginStoryboard>

                                                <Storyboard RepeatBehavior="Forever"
                                                            AutoReverse="True">

                                                    <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0.55"
                                                                     To="1"
                                                                     Duration="0:0:1"/>

                                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="0.94"
                                                                     To="1.06"
                                                                     Duration="0:0:1"/>

                                                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     From="0.94"
                                                                     To="1.06"
                                                                     Duration="0:0:1"/>

                                                </Storyboard>

                                            </BeginStoryboard>

                                        </EventTrigger>

                                    </Ellipse.Triggers>

                                </Ellipse>

                                <!-- ANEL INTERNO -->

                                <Ellipse Width="82"
                                         Height="82"
                                         Stroke="{StaticResource RedAccentBrush}"
                                         StrokeThickness="2"
                                         Opacity="0.85"/>

                                <!-- TRIÂNGULO -->

                                <Path Width="42"
                                      Height="38"
                                      Fill="{StaticResource RedAccentBrush}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M12,2 L22,20 H2 Z"/>

                                <!-- EXCLAMAÇÃO -->

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,5,0,0">

                                    <Rectangle Width="3"
                                               Height="12"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Fill="#351B27"/>

                                    <Ellipse Width="3.5"
                                             Height="3.5"
                                             Fill="#351B27"
                                             Margin="0,3,0,0"/>

                                </StackPanel>

                            </Grid>

                            <!-- ====================================== -->
                            <!-- PROGRESSO CIRCULAR -->
                            <!-- ====================================== -->

                            <controls:CircularProgressBar Progress="{Binding ScanProgress, TargetNullValue=0}"
                                                          Width="118"
                                                          Height="118">

                                <controls:CircularProgressBar.Style>

                                    <Style TargetType="controls:CircularProgressBar">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsScanning}"
                                                         Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </controls:CircularProgressBar.Style>

                            </controls:CircularProgressBar>

                        </Grid>

                        <!-- ========================================== -->
                        <!-- TEXTO HERO -->
                        <!-- ========================================== -->

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">

                            <TextBlock Text="{Binding HeroLabel}"
                                       Foreground="{Binding HeroAccent}"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding HeroTitle}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       Margin="0,7,0,0"/>

                            <TextBlock Text="{Binding HeroSubtitle}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,7,15,0"/>

                            <!-- BOTÕES -->

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,20,0,0">

                                <!-- VERIFICAR -->

                                <Button Command="{Binding ReconnectCommand}"
                                        Height="48"
                                        MinWidth="190"
                                        Padding="18,0"
                                        Background="#35D5C4"
                                        Foreground="#061E1B"
                                        BorderThickness="0"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="12">

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">

                                                    <TextBlock Text="&#xE72C;"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="17"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Text="{Binding ReconnectText}"
                                                               VerticalAlignment="Center"/>

                                                </StackPanel>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root"
                                                            Property="Background"
                                                            Value="#45E0D0"/>
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root"
                                                            Property="Background"
                                                            Value="#27BFAF"/>
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Root"
                                                            Property="Opacity"
                                                            Value="0.55"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>


                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- ================================================== -->
                <!-- RESUMO -->
                <!-- ================================================== -->

                <Border Grid.Column="2"
                        Style="{StaticResource DashboardCardStyle}">

                    <StackPanel>

                        <TextBlock Text="Resumo"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <Border Height="1"
                                Background="#283657"/>

                        <!-- SERVICE -->

                        <Grid Margin="0,18,0,17">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{Binding ServiceBadgeForeground}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="Service"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ServiceStatus}"
                                       Foreground="{Binding ServiceBadgeForeground}"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                        </Grid>

                        <Border Height="1"
                                Background="#283657"/>

                        <!-- INTEGRIDADE -->

                        <Grid Margin="0,18,0,17">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{Binding HeroAccent}"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="Integridade"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding IntegrityStatus}"
                                       Foreground="{Binding HeroAccent}"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                        </Grid>

                        <Border Height="1"
                                Background="#283657"/>

                        <!-- ÚLTIMA VERIFICAÇÃO -->

                        <Grid Margin="0,18,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#586682"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="Última verificação"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding LastScan}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ====================================================== -->
            <!-- MÉTRICAS -->
            <!-- ====================================================== -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ARQUIVOS -->

                <Border Grid.Column="0"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#17294F"
                                CornerRadius="11">

                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource BlueAccentBrush}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Arquivos verificados"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding FilesVerified, TargetNullValue=—}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- PROBLEMAS ENCONTRADOS -->

                <Border Grid.Column="2"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#38202B"
                                CornerRadius="11">

                            <TextBlock Text="&#xE814;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource RedAccentBrush}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Problemas encontrados"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding ProblemsFound, TargetNullValue=—}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- PROBLEMAS REPARADOS -->

                <Border Grid.Column="4"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#15372F"
                                CornerRadius="11">

                            <TextBlock Text="&#xE90F;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Problemas reparados"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding ProblemsRepaired, TargetNullValue=—}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- DURAÇÃO -->

                <Border Grid.Column="6"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#3A3314"
                                CornerRadius="11">

                            <TextBlock Text="&#xE916;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource YellowAccentBrush}"
                                       FontSize="17"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Duração"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding LastScanDuration}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

            <!-- ====================================================== -->
            <!-- OPERAÇÃO ATUAL -->
            <!-- ====================================================== -->

            <Border Grid.Row="6"
                    Style="{StaticResource DashboardCardStyle}"
                    MinHeight="210">

                <Grid VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>

                        <TextBlock Text="Operação atual"
                                   Style="{StaticResource DashboardTitleStyle}"/>

                        <TextBlock Text="{Binding CurrentOperation}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <!-- BARRA HORIZONTAL SECUNDÁRIA -->

                    <ProgressBar Grid.Row="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ScanProgress, TargetNullValue=0}"
                                 Height="8"
                                 Background="#1B294A"
                                 Foreground="{StaticResource CyanAccentBrush}"
                                 BorderThickness="0"/>

                    <TextBlock Grid.Row="4"
                               Text="O Windows Integrity Guard continuará atualizando este estado enquanto a operação estiver em execução."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"/>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>