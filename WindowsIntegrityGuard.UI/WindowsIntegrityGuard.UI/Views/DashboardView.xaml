<UserControl x:Class="WindowsIntegrityGuard.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <StackPanel>

        <!-- HEADER -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Painel de integridade"
                           Style="{StaticResource PageTitleStyle}"/>

                <TextBlock Text="Acompanhe o estado do Windows e execute novas verificações."
                           Style="{StaticResource PageDescriptionStyle}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="▶  Verificar agora"
                    Command="{Binding StartScanCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- CARDS PRINCIPAIS -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SERVICE -->
            <Border Grid.Column="0"
                    Background="{Binding ServiceStatus, Converter={StaticResource ServiceStatusToBackgroundConverter}}"
                    BorderBrush="#3E4A64"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Service"
                                   Foreground="#D4DCEC"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="#46516D"
                                CornerRadius="10">
                            <TextBlock Text="&#xE90F;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="#AEB8CA"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding ServiceStatus}"
                                Foreground="{Binding ServiceStatus, Converter={StaticResource ServiceStatusToBrushConverter}}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Margin="0,20,0,6"/>

                    <TextBlock Text="Windows Integrity Guard Service"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- INTEGRIDADE -->
            <Border Grid.Column="2"
                     Background="{Binding IntegrityStatus, Converter={StaticResource IntegrityStatusToBackgroundConverter}}"
                     BorderBrush="#3E4A64"
                     BorderThickness="1"
                     CornerRadius="16"
                     Padding="20">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Integridade"
                                   Foreground="#D4DCEC"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="#456159"
                                CornerRadius="10">
                            <TextBlock Text="✓"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding IntegrityStatus}"
                               Foreground="{Binding IntegrityStatus, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,20,0,6"/>

                    <TextBlock Text="{Binding IntegrityMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ÚLTIMA VERIFICAÇÃO -->
            <Border Grid.Column="4"
                    Background="#354956"
                    CornerRadius="16"
                    Padding="20">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Última verificação"
                                   Foreground="#D4DCEC"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <Border Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="#42606C"
                                CornerRadius="10">
                            <TextBlock Text="&#xE823;"
                                       FontFamily="Segoe Fluent Icons"
                                       Foreground="{StaticResource CyanAccentBrush}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding LastScan}"
                               Foreground="{StaticResource CyanAccentBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,20,0,6"/>

                    <TextBlock Text="Última execução registrada"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MÉTRICAS -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ARQUIVOS -->
            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="Arquivos verificados"
                               Style="{StaticResource DashboardDescriptionStyle}"/>

                    <TextBlock Text="{Binding FilesVerified, TargetNullValue=--}"
                               Style="{StaticResource CardValueStyle}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- PROBLEMAS -->
            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="Problemas encontrados"
                               Style="{StaticResource DashboardDescriptionStyle}"/>

                    <TextBlock Text="{Binding ProblemsFound, TargetNullValue=--}"
                               Foreground="{StaticResource RedAccentBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- REPARADOS -->
            <Border Grid.Column="4"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="Problemas reparados"
                               Style="{StaticResource DashboardDescriptionStyle}"/>

                    <TextBlock Text="{Binding ProblemsRepaired, TargetNullValue=--}"
                               Foreground="{StaticResource GreenAccentBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- DURAÇÃO -->
            <Border Grid.Column="6"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>
                    <TextBlock Text="Duração"
                               Style="{StaticResource DashboardDescriptionStyle}"/>

                    <TextBlock Text="{Binding LastScanDuration}"
                               Foreground="{StaticResource YellowAccentBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BLOCO INFERIOR -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- OPERAÇÃO ATUAL -->
            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>

                    <TextBlock Text="Operação atual"
                               Style="{StaticResource DashboardTitleStyle}"/>

                    <TextBlock Text="{Binding CurrentOperation}"
                               Foreground="{StaticResource CyanAccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,14,0,10"/>

                    <TextBlock Text="O Windows Integrity Guard continuará atualizando este estado enquanto a operação estiver em execução."
                               Style="{StaticResource DashboardDescriptionStyle}"
                               TextWrapping="Wrap"/>

                    <ProgressBar Height="8"
                                 Margin="0,22,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ScanProgress}"
                                 Background="#1E263B"
                                 Foreground="{StaticResource GreenAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- RESUMO -->
            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}">

                <StackPanel>

                    <TextBlock Text="Resumo"
                               Style="{StaticResource DashboardTitleStyle}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Service"
                                       Style="{StaticResource DashboardDescriptionStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ServiceStatus}"
                                       Foreground="{StaticResource GreenAccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Integridade"
                                       Style="{StaticResource DashboardDescriptionStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding IntegrityStatus}"
                                       Foreground="{Binding IntegrityStatus, Converter={StaticResource IntegrityStatusToBrushConverter}}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Última verificação"
                                       Style="{StaticResource DashboardDescriptionStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastScan}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </Grid>

                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </StackPanel>
</UserControl>