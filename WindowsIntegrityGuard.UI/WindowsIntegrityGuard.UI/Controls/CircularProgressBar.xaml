<UserControl x:Class="WindowsIntegrityGuard.UI.Controls.CircularProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="110"
             Height="110">

    <Grid>

        <!-- ANEL DE FUNDO -->
        <Ellipse Stroke="#24304A"
                 StrokeThickness="8"
                 Fill="Transparent"
                 Margin="4"/>

        <!-- PROGRESSO -->
        <Path x:Name="ProgressPath"
              Stroke="#36D66B"
              StrokeThickness="8"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Fill="Transparent"/>

        <!-- TEXTO CENTRAL -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="{Binding Progress, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0}}"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="de 100"
                       Foreground="#8793AA"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,-2,0,0"/>

        </StackPanel>

    </Grid>
</UserControl>