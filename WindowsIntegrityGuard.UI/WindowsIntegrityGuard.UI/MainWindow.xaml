<Window x:Class="WindowsIntegrityGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WindowsIntegrityGuard.UI.Views"
        Title="Windows Integrity Guard"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="700"
        Background="#0C1723"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="#0C1723"
            BorderBrush="#31445A"
            BorderThickness="1"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Background="#0D1926">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="22,0,0,0">

                    <Border Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="#153B59">

                        <TextBlock Text="✓"
                                   Foreground="#56E682"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Windows Integrity Guard"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Protegendo a integridade do seu sistema"
                                   Foreground="#9EB2C7"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,140,0">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#35DC78"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="{Binding ServiceStatus}"
                               Foreground="#CFDCE8"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button Content="—"
                            Width="46"
                            Height="34"
                            Background="Transparent"
                            Foreground="#BAC7D4"
                            BorderThickness="0"
                            Click="MinimizeButton_Click"/>

                    <Button Content="□"
                            Width="46"
                            Height="34"
                            Background="Transparent"
                            Foreground="#BAC7D4"
                            BorderThickness="0"
                            Click="MaximizeButton_Click"/>

                    <Button Content="×"
                            Width="46"
                            Height="34"
                            Background="Transparent"
                            Foreground="#BAC7D4"
                            BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="#0B1723"
                        BorderBrush="#223449"
                        BorderThickness="0,1,1,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="14,22,14,0">

                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Content="⌂    Início"/>

                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Content="◷    Histórico"/>

                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Content="⚙    Configurações"/>

                            <Button Style="{StaticResource NavigationButtonStyle}"
                                    Content="ⓘ    Sobre"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="18,0,0,12"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Windows Integrity Guard"
                                       Foreground="#D7E4EF"
                                       FontSize="11"/>

                            <TextBlock Text="v0.5.0"
                                       Foreground="#7490A8"
                                       FontSize="10"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN AREA -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto">

                    <Grid Margin="22">
                        <StackPanel>
                            <TextBlock Text="Visão geral"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

                            <views:DashboardView DataContext="{Binding Dashboard}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>