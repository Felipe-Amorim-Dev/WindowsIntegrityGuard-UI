<Window x:Class="WindowsIntegrityGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WindowsIntegrityGuard.UI.Views"
        xmlns:viewModels="clr-namespace:WindowsIntegrityGuard.UI.ViewModels"
        Title="Windows Integrity Guard"
        Width="1280"
        Height="820"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource ApplicationBackgroundBrush}">

    <Window.Resources>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>

    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource MainBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="#17223D"
                BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <Border Width="44"
        Height="44"
        CornerRadius="13"
        Background="{StaticResource CyanAccentBrush}"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,24,0,0">

                    <Viewbox Width="25"
             Height="25"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

                        <Grid Width="24" Height="24">

                            <!-- ESCUDO -->
                            <Path Stroke="#071426"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Data="M12,2.7 L20,5.8 L20,11.2 C20,16.3 16.7,20.1 12,22 C7.3,20.1 4,16.3 4,11.2 L4,5.8 Z"/>

                            <!-- CHECK -->
                            <Path Stroke="#071426"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"
                  Data="M8.1,12.1 L10.8,14.8 L16.5,9.2"/>

                        </Grid>

                    </Viewbox>

                </Border>

                <!-- NAVEGAÇÃO -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0">

                    <Button Command="{Binding ShowDashboardCommand}">

                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                                        <Setter Property="Background" Value="#193767"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel>

                            <TextBlock Text="&#xE80F;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="21"
                                HorizontalAlignment="Center"/>

                            <TextBlock Text="Início"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding ShowHistoryCommand}">

                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsHistorySelected}" Value="True">
                                        <Setter Property="Background" Value="#193767"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel>

                            <TextBlock Text="&#xE81C;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="21"
                                HorizontalAlignment="Center"/>

                            <TextBlock Text="Histórico"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}">

                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                                        <Setter Property="Background" Value="#193767"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel>

                            <TextBlock Text="&#xE713;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="21"
                                HorizontalAlignment="Center"/>

                            <TextBlock Text="Ajustes"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding ShowAboutCommand}">

                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsAboutSelected}" Value="True">
                                        <Setter Property="Background" Value="#193767"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel>

                            <TextBlock Text="&#xE946;"
                                FontFamily="Segoe Fluent Icons"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="21"
                                HorizontalAlignment="Center"/>

                            <TextBlock Text="Sobre"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="v0.6.0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- CONTEÚDO -->
        <Grid Grid.Column="1">

            <ContentControl Content="{Binding CurrentViewModel}"
                            Margin="36,60,36,28"/>

            <!-- CONTROLES -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,8,0"
                        Panel.ZIndex="10"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

                <Button Content="—"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        Click="MinimizeButton_Click"/>

                <Button Content="□"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        Click="MaximizeButton_Click"/>

                <Button Content="×"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>