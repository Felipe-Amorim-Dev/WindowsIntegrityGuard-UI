<Window x:Class="WindowsIntegrityGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WindowsIntegrityGuard.UI.Views"
        xmlns:viewModels="clr-namespace:WindowsIntegrityGuard.UI.ViewModels"
        Title="Windows Integrity Guard"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="720"
        Background="{StaticResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="Transparent" CornerRadius="20">
        <Grid Margin="18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    CornerRadius="20"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">

                        <Border Width="46"
                                Height="46"
                                Background="#D8F6E9"
                                CornerRadius="13">

                            <TextBlock Text="✓"
                                       Foreground="#1DB978"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,1,0,0">
                            <TextBlock Text="Windows Integrity"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Protegendo o sistema"
                                       Foreground="{StaticResource SidebarSecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- NAVEGAÇÃO -->
                    <StackPanel Grid.Row="2">

                        <Button Style="{StaticResource NavigationButtonStyle}"
                                Command="{Binding ShowDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Width="28"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Início"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButtonStyle}"
                                Command="{Binding ShowHistoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Width="28"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Histórico"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButtonStyle}"
                                Command="{Binding ShowSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Width="28"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Configurações"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButtonStyle}"
                                Command="{Binding ShowAboutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Width="28"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Sobre"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- FOOTER -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Windows Integrity Guard"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="v0.5.0"
                                   Foreground="{StaticResource SidebarSecondaryTextBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- PAINEL PRINCIPAL -->
            <Border Grid.Column="2"
                    Background="{StaticResource MainBackgroundBrush}"
                    CornerRadius="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOPBAR -->
                    <Grid Grid.Row="0"
                          Margin="28,0,16,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- IDENTIFICAÇÃO -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Integrity Guard"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Monitoramento e integridade do Windows"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- STATUS SERVICE -->
                        <Border Grid.Column="1"
                                Background="#29344E"
                                CornerRadius="16"
                                Padding="12,7"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="9"
                                        Height="9"
                                        Fill="{Binding ServiceStatus, Converter={StaticResource ServiceStatusToBrushConverter}}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ServiceStatus}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                        </Border>

                        <!-- WINDOW CONTROLS -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">

                            <Button Content="—"
                                    Style="{StaticResource WindowCaptionButtonStyle}"
                                    Click="MinimizeButton_Click"/>

                            <Button Content="▢"
                                    Style="{StaticResource WindowCaptionButtonStyle}"
                                    Click="MaximizeButton_Click"/>

                            <Button Content="✕"
                                    Style="{StaticResource WindowCloseButtonStyle}"
                                    Click="CloseButton_Click"/>
                        </StackPanel>

                    </Grid>

                    <!-- CONTEÚDO DINÂMICO -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="28,10,28,28">
                            <ContentControl Content="{Binding CurrentViewModel}"/>
                        </Grid>

                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>