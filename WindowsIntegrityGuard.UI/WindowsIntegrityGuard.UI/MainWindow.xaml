<Window x:Class="WindowsIntegrityGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Integrity Guard"
        Width="1000"
        Height="650"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Windows Integrity Guard" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ServiceStatus}" FontSize="16" Margin="0,20,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
